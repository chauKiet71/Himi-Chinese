DATABASE_URL=postgresql://hanziwork:hanziwork@localhost:5432/hanziwork
AUTH_SECRET=replace-with-a-long-random-secret
# Separate 32-byte Base64 AES key for encrypting TOTP secrets. Keep stable and back it up.
ADMIN_TOTP_ENCRYPTION_KEY=
# Google Cloud Console > OAuth 2.0 Client (Web application).
# Callback local: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SEPAY_API_KEY=
# Khuyến nghị: cấu hình webhook SePay bằng HMAC-SHA256 và dùng cùng secret ở đây.
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=MBBANK
SEPAY_BANK_ACCOUNT_NUMBER=054611111
SEPAY_BANK_ACCOUNT_NAME=TRAN NGUYEN GIA HUY
# Domain chính thức khi deploy (HTTPS, ví dụ https://example.com); dùng cho sitemap và email xác thực.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Tên biến cũ vẫn được hỗ trợ làm fallback cho cấu hình tài khoản thanh toán.
VIP_BANK_NAME=
VIP_BANK_ACCOUNT_NUMBER=
VIP_BANK_ACCOUNT_NAME= 
# URL HTTPS của Worker staging, ví dụ https://hanziwork-staging.<account>.workers.dev
STAGING_APP_URL=
BREVO_API_KEY=
BREVO_FROM_EMAIL=hello@example.com
BREVO_FROM_NAME=Himi Chinese
AUTH_TRUST_X_FORWARDED_FOR=0
AUTH_TRUST_CF_CONNECTING_IP=0
# Chỉ dùng 0 khi chạy production build qua HTTP trên máy local; production thật nên để trống hoặc 1.
AUTH_COOKIE_SECURE=
CLOUDINARY_URL=
#

# iFlytek Pronunciation Assessment (streaming, Global). Lấy tại console-global.xfyun.cn.
# Chỉ đặt ở server; không đổi thành biến NEXT_PUBLIC_*.
IFLYTEK_ISE_APP_ID=
IFLYTEK_ISE_API_KEY=
IFLYTEK_ISE_API_SECRET=

# Himi support (server only). Cloudinary above is reused for authenticated images.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Optional SePay notification destination: personal chat ID or private group ID.
# Leave empty to use TELEGRAM_ADMIN_CHAT_ID. Start the bot first for personal messages.
TELEGRAM_PAYMENT_CHAT_ID=
# New-account alerts: personal chat ID or private group ID.
# Leave empty to use TELEGRAM_PAYMENT_CHAT_ID, then TELEGRAM_ADMIN_CHAT_ID.
TELEGRAM_REGISTRATION_CHAT_ID=
# Optional bootstrap operators for /groupid only (comma-separated numeric IDs).
# All current members of TELEGRAM_ADMIN_CHAT_ID can claim support; bot must be a group admin.
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL (tunnel for local development).
SUPPORT_WEBHOOK_BASE_URL=
# Dedicated Node worker, not a Next.js/serverless timer. Range: 250–5000 ms.
SUPPORT_WORKER_POLL_MS=1000
