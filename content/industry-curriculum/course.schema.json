{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Himi Chinese — Industry Curriculum v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "courseSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 160
    },
    "category": {
      "enum": [
        "Văn phòng",
        "Nhà máy",
        "Logistics",
        "Kinh doanh",
        "Dịch vụ"
      ]
    },
    "language": {
      "const": "zh-CN"
    },
    "translationLanguage": {
      "const": "vi"
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/module"
      },
      "minItems": 1
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/lesson"
      },
      "minItems": 1
    },
    "learningDesign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "authoredAppliedLessons": {
          "type": "integer",
          "minimum": 0
        },
        "originalLessonCount": {
          "type": "integer",
          "minimum": 0
        },
        "audio": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "audience",
        "sequence",
        "authoredAppliedLessons",
        "originalLessonCount",
        "audio"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "courseSlug",
    "category",
    "language",
    "translationLanguage",
    "level",
    "modules",
    "lessons",
    "learningDesign"
  ],
  "definitions": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "slug",
        "title",
        "description"
      ]
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 180
        },
        "hanzi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "pinyin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "type": "string",
          "minLength": 1
        },
        "audioUrl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:/(?!/)|https://)"
            }
          ]
        }
      },
      "required": [
        "slug",
        "hanzi",
        "pinyin",
        "meaning",
        "example",
        "translation",
        "audioUrl"
      ]
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "type": "string",
          "minLength": 1
        },
        "hanzi": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "speaker",
        "hanzi",
        "pinyin",
        "translation"
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "pattern",
        "explanation"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "correctOption": {
          "type": "integer",
          "minimum": 0
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "prompt",
        "options",
        "correctOption",
        "explanation"
      ]
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "passScore": {
          "type": "integer",
          "minimum": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/question"
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "description",
        "passScore",
        "questions"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dialogue": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/line"
          },
          "minItems": 4
        },
        "phrases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/line"
          },
          "minItems": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/note"
          },
          "minItems": 0
        },
        "challenge": {
          "$ref": "#/definitions/challenge"
        }
      },
      "required": [
        "dialogue",
        "notes"
      ]
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "moduleSlug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 160
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "situation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "isFree": {
          "type": "boolean"
        },
        "content": {
          "$ref": "#/definitions/content"
        },
        "vocabulary": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/word"
          },
          "minItems": 6
        }
      },
      "required": [
        "moduleSlug",
        "slug",
        "title",
        "summary",
        "situation",
        "estimatedMinutes",
        "isFree",
        "content",
        "vocabulary"
      ]
    }
  }
}
